{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "rappasoft/laravel-livewire-tables",
                "version": "dev-l13-patched",
                "require": {
                    "php": "^8.1|^8.2|^8.3|^8.4|^8.5",
                    "blade-ui-kit/blade-heroicons": "^2.1",
                    "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
                    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
                    "livewire/livewire": "^3.0|dev-main"
                },
                "autoload": {
                    "psr-4": {
                        "Rappasoft\\LaravelLivewireTables\\": "src"
                    }
                },
                "extra": {
                    "laravel": {
                        "providers": [
                            "Rappasoft\\LaravelLivewireTables\\LaravelLivewireTablesServiceProvider"
                        ]
                    }
                },
                "dist": {
                    "url": "https://github.com/Rappasoft/laravel-livewire-tables/archive/master.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.43",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^3.6.4",
        "livewire/volt": "^1.7.0",
        "maatwebsite/excel": "^3.1",
        "nesbot/carbon": "^3.0",
        "rappasoft/laravel-livewire-tables": "dev-l13-patched",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-permission": "^6.21"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16 || ^4.0",
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.3 || ^3.0",
        "laravel/pail": "^1.2.2 || ^2.0",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6 || ^9.0",
        "pestphp/pest": "^4.4.1",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "composer": {
            "stability-flags": {
                "rappasoft/laravel-livewire-tables": "dev"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
