# Production env template for onestopstore.co.zw's laravel-crm.
# Copy to .env on the server and fill in every CHANGE_ME.
# DB_HOST/DB_PORT/REDIS_HOST/REDIS_PORT are forced by docker-compose.yml's
# onestopstore-laravel-crm environment: block regardless of what's set here.

APP_NAME="OneStopStore CRM"
APP_ENV=production
APP_KEY=                          # generate: docker compose exec onestopstore-laravel-crm php artisan key:generate --show
APP_DEBUG=false

APP_URL=https://crm.onestopstore.co.zw
API_TOKEN=CHANGE_ME
API_WEBHOOK_SECRET=CHANGE_ME_RANDOM_64_CHARS      # must match laravel-api's CRM_WEBHOOK_SECRET
FRONTEND_URL=https://onestopstore.co.zw

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=onestopstore-postgresql
DB_PORT=5432
DB_DATABASE=onestopstore_crm
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_DRIVER=database
CACHE_STORE=database
CACHE_PREFIX=crm_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=onestopstore-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=admin@onestopstore.co.zw
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=CHANGE_ME
